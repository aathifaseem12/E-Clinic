<!DOCTYPE html>
<html>
<head>
  <title>Add Growth Record · E-Clinic</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <nav>
    <div class="brand"><i class="fa-solid fa-house-medical"></i>E-Clinic</div>
    <div>
      <a href="/dashboard"><i class="fa-solid fa-table-columns"></i>Dashboard</a>
      <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i>Log out</a>
    </div>
  </nav>

  <div class="container" style="max-width:560px;">
    <div class="eyebrow">Worker tool</div>
    <h1><i class="fa-solid fa-chart-line"></i> Add Growth Record</h1>

    <% if (error) { %>
      <div class="error"><i class="fa-solid fa-circle-exclamation" style="margin-top:2px;"></i><span><%= error %></span></div>
    <% } %>
    <% if (success) { %>
      <div class="success"><i class="fa-solid fa-circle-check" style="margin-top:2px;"></i><span><%= success %></span></div>
    <% } %>

    <div class="step-list">
      <div class="step-pill <%= !children ? 'active' : '' %>">1. Find parent</div>
      <div class="step-pill <%= children ? 'active' : '' %>">2. Select child & record</div>
    </div>

    <% if (!children) { %>
      <div class="card">
        <h2 style="font-size:18px;">Find Parent</h2>
        <form action="/add-growth/search" method="POST">
          <label>Parent's NIC number <span class="req">*</span></label>
          <input type="text" name="nic" data-id="true" placeholder="e.g. 199912345678" required>
          <button type="submit" style="margin-top:18px;"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
        </form>
      </div>
    <% } else { %>
      <div class="card">
        <h2 style="font-size:18px;">Select Child & Enter Measurements</h2>
        <p style="font-size:13.5px; color:var(--ink-soft);">Parent: <strong style="color:var(--ink);"><%= parent.name %></strong></p>

        <form action="/add-growth/save" method="POST">
          <label>Select child <span class="req">*</span></label>
          <select name="childId" required>
            <% children.forEach(child => { %>
              <option value="<%= child.id %>"><%= child.name %> (born <%= child.date_of_birth %>)</option>
            <% }); %>
          </select>

          <label>Date of measurement <span class="req">*</span></label>
          <input type="date" name="date" required>

          <label>Weight (kg) <span class="req">*</span></label>
          <input type="number" step="0.01" min="0.01" max="400" name="weight" required>

          <label>Height (cm) <span class="req">*</span></label>
          <input type="number" step="0.1" min="0.1" max="300" name="height" required>

          <button type="submit" style="margin-top:18px;"><i class="fa-solid fa-floppy-disk"></i> Save Record</button>
        </form>
      </div>
    <% } %>
  </div>
</body>
</html>